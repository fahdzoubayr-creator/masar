# مفاتيح توليد الأسئلة — انسخ هذا الملف إلى .env ثم ضع مفتاحًا واحدًا على الأقل.
#   copy .env.example .env
# .env مستثنى من git؛ لا تضع أي مفتاح في ملف آخر.
#
# الترتيب: Gemini أولًا، ثم Groq، ثم GitHub.
# عند نفاد حصة أحدهم أو ضغط طلباته (429/503) ينتقل التوليد تلقائيًا للتالي.
# كلهم OpenAI-compatible، فلا حاجة لتعديل الكود.

# 1) Google Gemini — المولد الأساسي: الأفضل للعربية وسريع الاستجابة
#    المفتاح: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# ملاحظة: gemini-2.5-flash و gemini-2.5-flash-lite يرجعان 404 لمفاتيح جديدة،
# لذلك لم يبقيا في القائمة الافتراضية.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash

# 2) Groq — احتياطي سريع، لكن 6000 توكن/دقيقة فقط لكل النماذج
#    المفتاح: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=allam-2-7b,qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# 3) GitHub Models — احتياطي ثالث، مجاني بحسابك وبلا بطاقة ائتمان
#    المفتاح: https://github.com/settings/tokens  (صلاحية models:read)
GITHUB_TOKEN=
# GITHUB_MODELS=mistral-large-2411,AI21-Jamba-1.5-Large,Phi-4
