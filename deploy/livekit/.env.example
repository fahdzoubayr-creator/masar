# ============================================================
#  ملف البيئة — انسخه باسم .env وعدّل القيم قبل التشغيل
#     cp .env.example .env
#  ⚠️ لا ترفع ملف .env إلى أي مستودع ولا تشاركه أبداً.
# ============================================================

# النطاق الفرعي لخادم البث (يجب أن يشير سجل A له إلى IP هذا الخادم)
LIVEKIT_DOMAIN=livekit.ehtiraf-app.com

# مفتاح API للإنتاج — ولّده بـ:
#   openssl rand -hex 16
LIVEKIT_API_KEY=APIchangeMe1234567890ab

# سر API للإنتاج (يوقّع به التوكنات خادمياً فقط) — ولّده بـ:
#   openssl rand -hex 32
LIVEKIT_API_SECRET=changeMe_64_hex_chars_output_of_openssl_rand_hex_32
